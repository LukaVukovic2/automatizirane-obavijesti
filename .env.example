# ─── Required ────────────────────────────────────────────────────────────────

# Polling interval in minutes (integer, 1–1440; defaults to 5 if not set)
# Recommended: 10–15 minutes to reduce bot-detection risk
CHECK_INTERVAL_MINUTES=15

# ─── Optional ─────────────────────────────────────────────────────────────────

# Log verbosity level: DEBUG, INFO, WARNING, ERROR, or CRITICAL (defaults to INFO)
LOG_LEVEL=INFO

